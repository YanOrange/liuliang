<?php

namespace {%controllerNamespace%};

use laytp\controller\Backend;
use laytp\library\CommonFun;{%useAdminUserServiceFacade%}{%uploadDomainPackage%}
use laytp\library\Tree;

/**
 * {%tableComment%}
 */
class {%controllerClassName%} extends Backend
{

    /**
     * {%modelName%}模型对象
     * @var \{%modelNamespace%}\{%modelClassName%}
     */
    protected $model;{%hasSoftDel%}{%orderRule%}

    protected $noNeedLogin = []; // 无需登录即可请求的方法
    protected $noNeedAuth = ['index', 'info']; // 无需鉴权即可请求的方法

    public function _initialize()
    {
        $this->model = new \{%modelNamespace%}\{%modelClassName%}();
    }

    {%indexFunction%}

    {%addFunction%}

    {%editFunction%}

    //删除
    public function del()
    {
        $ids = $this->request->post('ids');
        if (!$ids) {
            return $this->error('参数ids不能为空');
        }

        $sourceData = $this->model->select()->toArray();
        $treeLib = Tree::instance();
        $treeLib->init($sourceData);
        $childIds = $treeLib->getChildIds($ids);

        if ($this->model->destroy($childIds)) {
            return $this->success('数据删除成功');
        } else {
            return $this->error('数据删除失败');
        }
    }

    {%recycleFunction%}

    {%tableEditFunction%}
}
